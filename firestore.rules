rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "RasSDNYrS9fWmapEQyR6p5UkbDr1";
    }

    match /boards/{boardId} {
      allow read, write: if isOwner();

      match /widgets/{widgetId} {
        allow read, write: if isOwner();
      }
    }
  }
}
